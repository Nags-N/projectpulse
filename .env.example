# ProjectPulse AI Configuration
# Copy this file to .env and fill in your details

# Database
DATABASE_URL=sqlite:///./data/projectpulse.db

# Real Jira Cloud REST API Credentials (Required for Live Jira Cloud Synchronization)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=KAN

# Optional AI API Keys for Advanced LLM Synthesis (if omitted, high-accuracy semantic synthesizer is used)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
